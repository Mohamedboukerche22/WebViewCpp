# wvc_embed_assets(<target>
#                   PACK   <path/to/app.wvcp>
#                   [OUTPUT <generated.cpp>]
#                   [LABEL  <name>])
#
# Generates a translation unit that registers a packed WebViewCpp asset bundle
# with the runtime, then adds it to <target>. The generated file uses the same
# WVC_EMBED_ASSETS mechanism the `wvc` CLI produces, so the two are
# interchangeable.
#
#   wvc_embed_assets(myapp PACK "${CMAKE_SOURCE_DIR}/dist/app.wvcp")
#
# This is a pure-CMake implementation so it works even when the CLI is not
# installed. For very large bundles prefer `wvc build`, which streams the file
# instead of round-tripping it through CMake strings.
function(wvc_embed_assets target)
    cmake_parse_arguments(ARG "" "PACK;OUTPUT;LABEL" "" ${ARGN})

    if(NOT ARG_PACK OR NOT EXISTS "${ARG_PACK}")
        message(FATAL_ERROR "wvc_embed_assets: PACK must name an existing .wvcp file")
    endif()
    if(NOT ARG_OUTPUT)
        get_filename_component(_stem "${ARG_PACK}" NAME_WE)
        set(ARG_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${_stem}_assets.cpp")
    endif()
    if(NOT ARG_LABEL)
        get_filename_component(ARG_LABEL "${ARG_PACK}" NAME)
    endif()

    file(READ "${ARG_PACK}" _hex HEX)
    string(REGEX MATCHALL ".." _bytes "${_hex}")

    set(_literal "\"")
    set(_i 0)
    foreach(_byte IN LISTS _bytes)
        string(APPEND _literal "\\x${_byte}")
        math(EXPR _i "${_i} + 1")
        math(EXPR _mod "${_i} % 32")
        if(_mod EQUAL 0)
            string(APPEND _literal "\"\n    \"")
        endif()
    endforeach()
    string(APPEND _literal "\"")

    file(WRITE "${ARG_OUTPUT}"
"// Generated by wvc_embed_assets() from ${ARG_PACK}
#include \"webviewcpp/embed.hpp\"

namespace {
alignas(16) const unsigned char kAssetsBlob[] =
    ${_literal};
}  // namespace

WVC_EMBED_ASSETS(kAssetsBlob, sizeof(kAssetsBlob) - 1, \"${ARG_LABEL}\");
")

    target_sources(${target} PRIVATE "${ARG_OUTPUT}")
    set_source_files_properties("${ARG_OUTPUT}" PROPERTIES GENERATED TRUE)
    message(STATUS "wvc_embed_assets: ${ARG_PACK} -> ${ARG_OUTPUT}")
endfunction()
